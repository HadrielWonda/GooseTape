# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Secret. From Ductape workspace -> Tokens -> SDK Access Key.
# Doubles as the shared secret the C# function host verifies invocation signatures with,
# so the host must be started with the same value in DUCTAPE_ACCESS_KEY.
DUCTAPE_ACCESS_KEY=

# Not secret. Identifies the workspace and is safe to expose to clients.
DUCTAPE_WORKSPACE=
DUCTAPE_PUBLISHABLE_KEY=

# The product tag and environment slug created in the Ductape workbench.
DUCTAPE_PRODUCT=goosetape
DUCTAPE_ENV=dev

# Base URL of the C# portable function host, with no trailing slash.
# Plain HTTP is only accepted for localhost; anything else must be HTTPS.
DUCTAPE_FUNCTION_BASE_URL=http://127.0.0.1:5207
